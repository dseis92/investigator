# MatterPilot environment template
# Copy this file to .env.local, then replace every placeholder before running
# the app locally or deploying it. Never commit .env.local or real secret values.

# -----------------------------------------------------------------------------
# Supabase
# Find these in Supabase Dashboard → Project Settings → API.
# The URL and publishable key are used by the browser and protected by RLS.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Server-only Supabase key.
# Used by the seed script and live security tests. Never use this in client code
# and never expose it as a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# -----------------------------------------------------------------------------
# OpenAI / assisted analysis
# Optional until AI-assisted analysis is enabled. Find the key in the OpenAI
# Platform API keys area. Keep it server-only.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.1

# -----------------------------------------------------------------------------
# Scheduled operations
# Vercel Cron sends this value as Authorization: Bearer <CRON_SECRET>.
# Generate a long random value and add it to Vercel for Production (and local
# Development if you want to invoke the route manually).
# -----------------------------------------------------------------------------
CRON_SECRET=YOUR_LONG_RANDOM_CRON_SECRET

# -----------------------------------------------------------------------------
# Vercel deployment note
# Vercel deployment authentication is managed by the Vercel CLI. Do not add
# VERCEL_OIDC_TOKEN here manually; it is generated and stored locally by Vercel.
# Add the four values above to the Vercel project's Environment Variables for
# Development, Preview, and Production as appropriate.
# -----------------------------------------------------------------------------
